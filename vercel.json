{
 "outputDirectory": "public",
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://xeluoexmhsyuthgnqzuw.supabase.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=()"
    },
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  }
 ]
}